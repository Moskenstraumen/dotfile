#!/usr/bin/env sh

sudo yabai --load-sa
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"

# General
yabai -m config layout bsp
yabai -m config split_ratio 0.50
yabai -m config auto_balance off

# Window
yabai -m config window_placement second_child
yabai -m config window_opacity off
yabai -m config window_opacity_duration 0.0
yabai -m config active_window_opacity 1.0
yabai -m config normal_window_opacity 0.9

# Window border
yabai -m config external_bar all:32:0
yabai -m config window_border off
yabai -m config window_border_width 4
yabai -m config active_window_border_color 0xffffbb7d
yabai -m config normal_window_border_color 0xff353c54

# Mouse
yabai -m config mouse_follows_focus on
yabai -m config focus_follows_mouse autofocus
yabai -m config mouse_modifier shift cmd
yabai -m config mouse_action1 move
yabai -m config mouse_action2 resize

# Paddings
yabai -m config top_padding 2
yabai -m config bottom_padding 2
yabai -m config left_padding 2
yabai -m config right_padding 2
yabai -m config window_gap 2

# Display hotplug layout sync
SYNC_LAYOUT='bash -c '\''source "$HOME/.config/yabai/scripts/utils.sh" && sync_display_layout'\'''
yabai -m signal --add event=display_removed action="$SYNC_LAYOUT"
yabai -m signal --add event=display_added action="$SYNC_LAYOUT"

# SketchyBar event signals
for ev in window_focused window_created window_destroyed window_minimized window_deminimized; do
  yabai -m signal --add event="$ev" action="sketchybar --trigger yabai_window_change"
done

# Float apps
yabai -m rule --add app="^(Calculator|Software Update|Dictionary|System Preferences|System Settings|Photo Booth|Archive Utility|Python|LibreOffice|App Store|Activity Monitor|Finder|Terminal|Notes|Reminders|WeChat|Spotify|Tailscale)$" manage=off
yabai -m rule --add label="About This Mac" app="System Information" title="About This Mac" manage=off

# Initial display layout setup
(
  sleep 2
  bash -c 'source "$HOME/.config/yabai/scripts/utils.sh" && sync_display_layout'
) &

yabai -m rule --apply
echo "yabai configuration loaded.."
