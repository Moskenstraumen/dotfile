export ZSH="$HOME/.oh-my-zsh"

# starship renders the prompt, so oh-my-zsh's own theme stays unset.
ZSH_THEME=""

plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

source $ZSH/oh-my-zsh.sh

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

[[ -f ~/.config/zsh/alias.common.zsh ]] && source ~/.config/zsh/alias.common.zsh
[[ -f ~/.config/zsh/alias.local.zsh ]]  && source ~/.config/zsh/alias.local.zsh
[[ -f ~/.config/zsh/secrets.zsh ]]      && source ~/.config/zsh/secrets.zsh

# zoxide takes over cd itself: plain paths still work, anything else is a
# frecency jump. `cdi` picks interactively. Directory tab-completion is
# unaffected; zoxide only adds its own query on Space-Tab.
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"

# Ctrl-R history search, Ctrl-T file insert, Alt-C directory jump.
command -v fzf >/dev/null && eval "$(fzf --zsh)"


eval "$(starship init zsh)"
