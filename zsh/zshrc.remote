export ZSH="$HOME/.oh-my-zsh"

# starship renders the prompt, so oh-my-zsh's own theme stays unset.
ZSH_THEME=""

plugins=(
    git
    zsh-autosuggestions
    zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

export TERM=xterm-256color

HISTSIZE=10000
SAVEHIST=10000
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt INC_APPEND_HISTORY

# nvm is a shell function, so it still has to be sourced here; the default
# node's PATH entry comes from ~/.nvm/current in zshenv.remote.
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

[[ -f ~/.config/zsh/alias.common.zsh ]] && source ~/.config/zsh/alias.common.zsh
[[ -f ~/.config/zsh/alias.remote.zsh ]] && source ~/.config/zsh/alias.remote.zsh
[[ -f ~/.config/zsh/secrets.zsh ]]      && source ~/.config/zsh/secrets.zsh

# zoxide takes over cd itself: plain paths still work, anything else is a
# frecency jump. `cdi` picks interactively. Directory tab-completion is
# unaffected; zoxide only adds its own query on Space-Tab.
command -v zoxide >/dev/null && eval "$(zoxide init zsh --cmd cd)"

# Guarded: a rate-limited bootstrap may not have installed fzf either.
command -v fzf >/dev/null && eval "$(fzf --zsh)"

# Make sure the cursor is visible again after a dropped connection
printf '\e[?25h'

eval "$(starship init zsh)"
