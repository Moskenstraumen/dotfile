# Font
font-family = "Maple Mono NF CN"

# Theme
theme = glass-dark

# Transparency lives in the theme file (themes/glass-dark);
# setting it here would override the per-theme values.

# Window
macos-titlebar-style = hidden
window-padding-x = 8
window-padding-y = 0
window-padding-balance = true

# Mouse & Input
macos-option-as-alt = left

# App Behavior
confirm-close-surface = false

# herdr: Ghostty stays a single window; these send the herdr prefix (ctrl+b,
# herdr's default, = 0x02) plus the action key, so tabs and splits live in
# herdr and survive detach.
keybind = cmd+t=text:\x02c
keybind = cmd+n=text:\x02a
keybind = cmd+d=text:\x02v
keybind = cmd+shift+d=text:\x02-
keybind = cmd+w=text:\x02x
keybind = cmd+enter=text:\x02z
keybind = cmd+[=text:\x02;
keybind = cmd+bracket_left=text:\x02;
keybind = cmd+]=text:\x02\x09
keybind = cmd+bracket_right=text:\x02\x09
keybind = cmd+shift+[=text:\x02[
keybind = cmd+shift+bracket_left=text:\x02[
keybind = cmd+shift+]=text:\x02]
keybind = cmd+shift+bracket_right=text:\x02]
keybind = cmd+digit_1=text:\x021
keybind = cmd+digit_2=text:\x022
keybind = cmd+digit_3=text:\x023
keybind = cmd+digit_4=text:\x024
keybind = cmd+digit_5=text:\x025
keybind = cmd+digit_6=text:\x026
keybind = cmd+digit_7=text:\x027
keybind = cmd+digit_8=text:\x028
keybind = cmd+digit_9=text:\x029
