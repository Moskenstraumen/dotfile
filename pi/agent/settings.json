{
  "defaultProvider": "modelproxy",
  "defaultModel": "gpt-6.1-sol-coding",
  "defaultThinkingLevel": "medium",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "user-only",
  "branchSummary": {
    "skipPrompt": true
  },
  "theme": "system",
  "defaultTools": [
    "+ls",
    "+codemode"
  ],
  "compaction": {
    "modelOverrides": {
      "modelproxy/claude-opus-5.5": {
        "reserveTokens": 600000
      },
      "gw/claude-opus-5-5": {
        "reserveTokens": 600000
      }
    }
  },
  "packages": [
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@gotgenes/pi-permission-system",
    "npm:pi-tidy",
    "npm:pi-starline",
    "npm:pi-background"
  ],
  "lastChangelogVersion": "1.4.0",
  "showCacheMissNotices": false,
  "cacheWarming": "idle",
  "enableSkillCommands": false,
  "markdown": {
    "mermaid": "final"
  },
  "hideThinkingBlock": false,
  "showHardwareCursor": true,
  "transport": "auto",
  "tidy": {
    "alwaysShowTools": [
      "edit",
      "write"
    ],
    "toolColors": {
      "bash": "bashMode",
      "read": "toolTitle",
      "edit": "syntaxVariable",
      "write": "syntaxVariable",
      "grep": "syntaxOperator",
      "find": "syntaxOperator",
      "ls": "syntaxOperator"
    }
  }
}
