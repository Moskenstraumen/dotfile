# macOS
.DS_Store

# Local generated files
*.bak
*.log

# Tags
tags
.tags
GTAGS
GRTAGS
GPATH

# Machine-local state and credentials — never tracked
gh/
mole/
karabiner/*backups/

# zsh runtime state
zsh/.zsh_sessions/
zsh/.zsh_history
zsh/.zcompcache/
zsh/.zcompdump*
zsh/*.zwc*

# Secrets are sourced if present; only the example is tracked
zsh/secrets.zsh
