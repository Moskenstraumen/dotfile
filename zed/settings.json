{
    "disable_ai": true,
    "which_key": {
        "delay_ms": 0,
        "enabled": true
    },
    "edit_predictions": {
        "allow_data_collection": "no"
    },
    "title_bar": {
        
    },
    "status_bar": {
        "show_active_file": false
    },
    "diagnostics": {
        "button": false
    },
    "debugger": {
        "button": false
    },
    "agent": {
        "terminal_init_command": "proxy_off && stepcode claude",
        "button": true,
        "dock": "left",
        "favorite_models": [],
        "model_parameters": []
    },
    "collaboration_panel": {
        "button": false
    },
    "ssh_connections": [
        {
            "host": "ali",
            "args": [],
            "projects": [
                {
                    "paths": [
                        "/mnt/cpfs/xuyucheng/./"
                    ]
                }
            ]
        }
    ],
    "proxy": "",
    "ui_font_size": 16.0,
    "markdown_preview_font_size": 15.0,
    "agent_buffer_font_size": 12.0,
    "ui_font_weight": 400.0,
    "session": {
        "trust_all_worktrees": true,
    },
    "outline_panel": {
        "button": false,
        "folder_indicator": "icon",
        "git_status": true,
    },
    "tabs": {
        "git_status": true,
    },
    "git_panel": {
        "file_icons": true,
        "tree_view": true,
        "button": true,
    },
    "gutter": {
        "folds": true,
    },
    "rounded_selection": false,
    "file_types": {
        "cmake": ["CMakeLists.txt", "*.cmake"],
        "yaml": [".clang*"],
    },
    "auto_indent_on_paste": true,
    "linked_edits": true,
    "show_whitespaces": "none",
    "indent_guides": {
        "enabled": false,
    },
    "base_keymap": "Zed",
    "vim_mode": true,
    "buffer_font_features": { "calt": true },
    "tab_size": 4,
    "hard_tabs": false,
    "soft_wrap": "editor_width",
    "cursor_shape": "bar",
    "cursor_blink": true,
    "current_line_highlight": "none",
    "minimap": {
        "show": "always"
    },
    "sticky_scroll": { "enabled": false },
    "scrollbar": { "axes": { "vertical": false, "horizontal": false } },
    "format_on_save": "on",
    "project_panel": {
        "button": false,
        "starts_open": false,
        "folder_indicator": "icon",
        "default_width": 300.0,
        "dock": "left",
        "auto_fold_dirs": false,
        "auto_reveal_entries": false,
        "show_diagnostics": "off",
        "git_status": true,
    },
    "git": { "inline_blame": { "enabled": true } },
    "telemetry": { "metrics": false, "diagnostics": false },
    "terminal": {
        "button": false,
        "font_size": 14.0,
        "font_family": "Maple Mono NF CN",
        "font_weight": 400.0,
        "dock": "bottom",
    },
  "theme": "Catppuccin Mocha (Blur) [Light]"
}
